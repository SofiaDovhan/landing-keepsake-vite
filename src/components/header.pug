header.header
  .container.header__inner
    a.logo(href="#top", aria-label=`${site.name} - home`)
      span.logo__mark(aria-hidden="true")= site.name.charAt(0)
      span.logo__text(aria-hidden="true")= site.name.slice(1)

    button.burger(type="button", popovertarget="main-nav", popovertargetaction="toggle", aria-controls="main-nav", aria-expanded="false", aria-label="Menu")
      +icon('burger')(class="burger__icon burger__icon--open")
      +icon('close')(class="burger__icon burger__icon--close")

    nav#main-nav.nav(popover, aria-label="Main")
      ul.nav__list
        each item in nav
          li.nav__item
            //- умови: модифікатор --active та aria-current лише для активного пункту
            a.nav__link(href=item.href, class={ 'nav__link--active': item.active }, aria-current=item.active ? 'page' : false)
              | #{item.label}
              +icon('chevron', 6, 11)(class="nav__chevron")

      .nav__actions
        +btn('Contact us', '#contact')(class="nav__mobile-btn")
          +icon('mail')
        button.fav-btn(type="button", aria-label="Favourites")
          +icon('heart')(class="fav-btn__icon")
          span.fav-btn__text Favourites

      .mobile-nav-info
        p.mobile-nav-info__label Say hello
        a.mobile-nav-info__text(href=`mailto:${site.email}`)= site.email
        a.mobile-nav-info__text(href=`tel:${site.phoneHref}`)= site.phone
        +socials()(class="mobile-nav-info__socials")
