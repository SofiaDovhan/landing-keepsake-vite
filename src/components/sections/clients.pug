//- Clients & testimonial
//- ініціали автора обчислюються з імені
- const initials = testimonial.name.split(' ').map((part) => part.charAt(0)).join('')

section.clients.section
  .container
    +section-head('Clients kind words')
      | Some of the teams that trusted us with their brands.

    ul.client-logos
      each client in clients
        li.client-logo(class=`logo-${client.slug}`)= client.name

    blockquote.testimonial
      span.quote-mark(aria-hidden="true") “
      p.testimonial-text= testimonial.quote
      footer.testimonial-author
        .author-info
          .author-avatar(aria-hidden="true")= initials
          .author-details
            p.author-name= testimonial.name
            p.author-role= testimonial.role
        .slider-dots(aria-hidden="true")
          each dot, i in Array.from({ length: testimonial.slides })
            span.dot(class={ active: i === 0 })
