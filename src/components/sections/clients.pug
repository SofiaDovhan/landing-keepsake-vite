//- Clients & testimonial
//- ініціали автора обчислюються з імені
- const initials = testimonial.name.split(' ').map((part) => part.charAt(0)).join('')

section.clients.section
  .container
    +section-head('Clients kind words')
      | Some of the teams that trusted us with their brands.

    ul.clients__logos
      each client in clients
        li.clients__logo(class=`clients__logo--${client.slug}`)= client.name

    blockquote.testimonial
      span.testimonial__mark(aria-hidden="true") “
      p.testimonial__text= testimonial.quote
      footer.testimonial__footer
        .author
          .author__avatar(aria-hidden="true")= initials
          .author__details
            p.author__name= testimonial.name
            p.author__role= testimonial.role
        .dots(aria-hidden="true")
          each dot, i in Array.from({ length: testimonial.slides })
            span.dots__item(class={ 'dots__item--active': i === 0 })
