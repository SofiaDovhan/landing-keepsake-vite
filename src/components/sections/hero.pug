//- Hero
section.hero
  .container
    h1.hero-title We're #{site.name}, a digital branding agency
    p.hero-desc Specializing in web design, poster, motion video, based in London. We love to turn ideas into beautiful things.
    .hero-actions
      +btn('See our works', '#works')
      +btn('Get in touch', '#contact', 'secondary')(aria-label=`Get in touch with ${site.name}`)
