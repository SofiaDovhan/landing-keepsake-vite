footer#contact.footer
  .container
    .footer__top
      include ./newsletter

      .footer__links
        each col in footerColumns
          .footer__col
            h2.footer__heading= col.title
            ul.footer__list
              each link in col.links
                li
                  a.footer__link(href=link.href)= link.label

    .footer__divider

    .footer__bottom
      p.footer__copyright #{site.year} #{site.name}. All rights reserved.
      +socials()
