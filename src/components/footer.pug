footer#contact.footer
  .container
    .footer-top
      include ./newsletter

      .footer-links
        each col in footerColumns
          .footer-col
            h2.footer-heading= col.title
            ul.footer-list
              each link in col.links
                li
                  a(href=link.href)= link.label

    .footer-divider

    .footer-bottom
      p.copyright #{site.year} #{site.name}. All rights reserved.
      +socials()
