//- +btn(label, href, variant)(…довільні атрибути)
//-   href є  → <a>, href немає → <button type="button">
//-   variant → модифікатор: primary | secondary
//-   block   → вкладений вміст (напр. іконка) виводиться перед підписом
mixin btn(label, href, variant = 'primary')
  - const cls = ['btn', `btn--${variant}`]
  //- пробіл між іконкою та текстом — як у lab-07
  - const gap = block ? ' ' : ''
  if href
    a(class=cls, href=href)&attributes(attributes)
      if block
        block
      | #{gap}#{label}
  else
    button(class=cls, type="button")&attributes(attributes)
      if block
        block
      | #{gap}#{label}
